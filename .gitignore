# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# Environment variables
.env

# IDE
.idea/
*.swp
*.swo
*~
.vscode/

# OS
.DS_Store
Thumbs.db

# Test / Coverage
.coverage
htmlcov/
.pytest_cache/

# Celery
celerybeat-schedule*
.celery/

# Redis snapshots (dev cache data — never commit)
dump.rdb
*.rdb

# Logs
*.log
logs/

# Migration
# (migration version files ARE tracked — alembic history needs them on clone)

# Certificates (actual .crt/.key files, not .gitkeep)
certs/*.crt
certs/*.key
certs/*.pem

# Deployment
deploy/*.pem
deploy/*.key

# Vendored tools (e.g. Windows redis-server extracted locally)
vendor/

# Internal collaboration / skill working files (never part of the product)
.team/
.superpowers/
docs/superpowers/

# Local IDE / assistant working state (config + scheduler locks; never commit)
.claude/
