# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/airquality

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=false
MQTT_TLS_CERT=./certs/client.crt
MQTT_TLS_KEY=./certs/client.key
MQTT_CA_CERTS=./certs/ca.crt

# JWT
JWT_SECRET=change-me-to-a-256-bit-random-secret
# H4: pinned to HS256 — any other value is rejected at startup.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Bootstrap admin (H5/H6/H28) — optional. When BOTH username and password are
# set, the API provisions this admin at startup with a bcrypt-hashed password.
# Leave empty in production unless you want auto-provisioning; prefer seeding
# via scripts/seed.py with SEED_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Reverse proxy (H12/H31) — set true ONLY when the API sits behind a trusted
# proxy that sets X-Real-IP (see deploy/nginx.conf). Never enable when the API
# is directly reachable, or clients could spoof their rate-limit bucket.
TRUST_PROXY_HEADERS=false

# Export throttle (H18) — minimum seconds between exports per user.
EXPORT_COOLDOWN_SECONDS=300

# Metrics endpoint (H19) — when set, /metrics requires a matching
# X-Metrics-Secret header. Leave empty to rely on network-level gating only.
METRICS_SECRET=

# AQI Thresholds
AQI_WARNING_THRESHOLD=100
AQI_CRITICAL_THRESHOLD=150

# Data Retention (days)
DATA_RETENTION_DAYS=365

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# App
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# Request body cap (M5) - bytes; larger HTTP bodies are rejected with 413.
# 64 KB fits CSV node-config uploads; bulk ingest goes over MQTT.
MAX_CONTENT_LENGTH=65536
