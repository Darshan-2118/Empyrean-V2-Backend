[Unit]
Description=Empyrean Celery Worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# L74: bound the restart loop — RestartSec=5 used to space attempts so the
# default rate limit never engaged and a persistent boot failure looped forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=empyrean
Group=empyrean
WorkingDirectory=/opt/empyrean
EnvironmentFile=/opt/empyrean/.env
ExecStart=/opt/empyrean/venv/bin/celery -A celery_app.celery_app worker --loglevel=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
