# Production env template — copy to /opt/empyrean/.env and fill in
APP_ENV=production
# Generate with: openssl rand -base64 48
SECRET_KEY=
# Generate with: openssl rand -base64 48
JWT_SECRET=
LOG_LEVEL=INFO
DATABASE_URL=postgresql://empyrean:CHANGE_ME@127.0.0.1:5432/airquality
REDIS_URL=redis://127.0.0.1:6379/0
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
MQTT_TLS_CERT=/opt/empyrean/certs/client.crt
MQTT_TLS_KEY=/opt/empyrean/certs/client.key
MQTT_CA_CERTS=/opt/empyrean/certs/ca.crt
AQI_WARNING_THRESHOLD=100
AQI_CRITICAL_THRESHOLD=150
DATA_RETENTION_DAYS=365
CORS_ORIGINS=https://<your-frontend-domain>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
