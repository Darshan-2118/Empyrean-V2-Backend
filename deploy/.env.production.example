# Production env template — copy to /opt/empyrean/.env and fill in
APP_ENV=production
# Generate with: openssl rand -base64 48
SECRET_KEY=
# Generate with: openssl rand -base64 48
JWT_SECRET=
LOG_LEVEL=INFO
DATABASE_URL=postgresql://empyrean:CHANGE_ME@127.0.0.1:5432/airquality
REDIS_URL=redis://127.0.0.1:6379/0
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
MQTT_TLS_CERT=/opt/empyrean/certs/client.crt
MQTT_TLS_KEY=/opt/empyrean/certs/client.key
MQTT_CA_CERTS=/opt/empyrean/certs/ca.crt
AQI_WARNING_THRESHOLD=100
AQI_CRITICAL_THRESHOLD=150
DATA_RETENTION_DAYS=365
CORS_ORIGINS=https://<your-frontend-domain>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Bootstrap admin (H5/H6/H28) — set BOTH username and password to auto-provision
# an admin at startup. The password is bcrypt-hashed before storage; never reuse
# a password committed anywhere in source control.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Reverse proxy (H12/H31) — nginx sets X-Real-IP; enable so per-IP rate limiting
# buckets real clients instead of collapsing all traffic into 127.0.0.1.
TRUST_PROXY_HEADERS=true

# Export throttle (H18) — minimum seconds between exports per user.
EXPORT_COOLDOWN_SECONDS=300

# Metrics endpoint (H19) — shared secret required in the X-Metrics-Secret header
# by Prometheus/scraper. Generate with: openssl rand -base64 32
METRICS_SECRET=
