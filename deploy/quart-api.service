[Unit]
Description=Empyrean Quart API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# L74: bound the restart loop — RestartSec=5 used to space attempts so the
# default rate limit never engaged and a persistent boot failure looped forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=empyrean
Group=empyrean
WorkingDirectory=/opt/empyrean
EnvironmentFile=/opt/empyrean/.env
ExecStart=/opt/empyrean/venv/bin/hypercorn app:create_app() --bind 127.0.0.1:8000 --workers 1 --access-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
