# Normalize line endings: store LF in the repo, check out per-platform.
* text=auto

# Shell scripts must stay LF (CRLF breaks bash).
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf

# Batch files work fine on Windows with CRLF.
*.bat text eol=crlf
